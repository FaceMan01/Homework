        <actionsetting showInAttributeTable="1" action="from QuickOSM.core.actions import Actions;Actions.run(&quot;josm&quot;,&quot;[% &quot;full_id&quot; %]&quot;)" icon="" capture="0" type="1" name="JOSM" shortTitle=""/>
        <actionsetting showInAttributeTable="1" action="http://www.openstreetmap.org/edit?[% &quot;osm_type&quot; %]=[% &quot;osm_id&quot; %]" icon="" capture="0" type="5" name="User default editor" shortTitle=""/>
        <actionsetting showInAttributeTable="1" action="from QuickOSM.core.actions import Actions;Actions.run(&quot;wikipedia&quot;,&quot;[% &quot;wikipedia&quot; %]&quot;)" icon="" capture="0" type="1" name="wikipedia" shortTitle=""/>
